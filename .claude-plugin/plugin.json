{
  "name": "termos",
  "version": "0.2.0",
  "description": "Interactive UI for Claude Code. Use `termos status` to see running session with tabs/panes. Use `termos run` for confirmations, progress, tables, diffs. Run `termos --help` for all commands.",
  "author": {
    "name": "termos-dev"
  },
  "repository": "https://github.com/termos-dev/termos",
  "license": "MIT",
  "keywords": ["ide", "interactive", "terminal", "claude-code", "zellij", "tui"],
  "commands": "./.claude-plugin/commands/",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/session-status.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
