{
  "name": "@termosdev/cli",
  "version": "0.4.0",
  "description": "Interactive TUI for Claude Code",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "termos": "dist/index.js"
  },
  "files": ["dist", ".claude-plugin", "skills", "templates", "!dist/**/*.map"],
  "scripts": {
    "build": "npm run build:shared && tsc && cp -r src/templates dist/ && npm run bundle:ink-runner",
    "build:shared": "cd packages/shared && npm run build",
    "bundle:ink-runner": "node scripts/bundle-ink-runner.mjs",
    "dev": "npm run serve",
    "dev:cli": "tsc --watch",
    "serve": "python -m http.server 8005 --directory docs",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "prepublishOnly": "npm run build",
    "prepare": "husky",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/termos-dev/termos.git"
  },
  "author": "termos-dev",
  "homepage": "https://github.com/termos-dev/termos#readme",
  "bugs": {
    "url": "https://github.com/termos-dev/termos/issues"
  },
  "keywords": ["tui", "interactive", "terminal", "claude-code", "ai-agent"],
  "license": "MIT",
  "dependencies": {
    "@termosdev/shared": "file:packages/shared",
    "date-fns": "^4.1.0",
    "mermaid-ascii": "^1.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@types/node": "^20.19.27",
    "@vitest/coverage-v8": "^4.0.17",
    "esbuild": "^0.27.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "typescript": "^5.3.0",
    "vitest": "^4.0.16"
  },
  "engines": {
    "node": ">=18"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": ["biome check --write"],
    "*.{json,md}": ["biome format --write"]
  }
}
