{
  "name": "agent-workbench",
  "version": "0.4.0",
  "description": "Interactive UI for Claude Code",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "awb": "dist/index.js"
  },
  "files": [
    "dist",
    ".claude-plugin",
    "skills",
    "templates",
    "ui/dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc && cp -r src/templates dist/ && npm run build:ui",
    "build:skills": "node scripts/build-skill.mjs",
    "build:ui": "tsc -p ui/tsconfig.json && vite build --config ui/vite.config.ts ui && BUILD_TARGET=web-components vite build --config ui/vite.config.ts ui",
    "dev": "npm run serve",
    "dev:cli": "tsc --watch",
    "serve": "npx serve docs -p 8005 --no-request-logging",
    "serve:python": "python -m http.server 8005 --directory docs",
    "start": "node dist/index.js",
    "test": "vitest run",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "prepublishOnly": "npm run build && npm run build:skills",
    "prepare": "husky",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/termos-dev/agent-workbench.git"
  },
  "author": "termos-dev",
  "homepage": "https://github.com/termos-dev/agent-workbench#readme",
  "bugs": {
    "url": "https://github.com/termos-dev/agent-workbench/issues"
  },
  "keywords": ["ui", "interactive", "playground", "claude-code", "ai-agent"],
  "license": "MIT",
  "dependencies": {
    "date-fns": "^4.1.0",
    "js-yaml": "^4.1.1",
    "mermaid-ascii": "^1.0.0",
    "node-pty": "^1.2.0-beta.10",
    "ws": "^8.18.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-markdown": "^6.3.1",
    "@codemirror/lang-python": "^6.1.6",
    "@codemirror/lang-rust": "^6.0.1",
    "@codemirror/lang-sql": "^6.8.0",
    "@codemirror/state": "^6.4.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.35.0",
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@git-diff-view/react": "^0.0.36",
    "@playwright/test": "^1.51.0",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-progress": "^1.1.1",
    "@radix-ui/react-radio-group": "^1.2.2",
    "@radix-ui/react-slot": "^1.1.1",
    "@tailwindcss/typography": "^0.5.19",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.19.27",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.0.17",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.10.0",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "dockview": "^4.13.1",
    "echarts": "^5.5.1",
    "echarts-for-react": "^3.0.2",
    "esbuild": "^0.27.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "lucide-react": "^0.468.0",
    "mermaid": "^11.4.1",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-arborist": "^3.4.0",
    "react-dom": "^18.3.1",
    "react-json-view-lite": "^2.1.0",
    "react-markdown": "^9.0.1",
    "rehype-highlight": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17",
    "tslib": "^2.8.1",
    "typescript": "^5.3.0",
    "vite": "^6.0.0",
    "vitest": "^4.0.16"
  },
  "engines": {
    "node": ">=18"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": ["biome check --write"],
    "*.{json,md}": ["biome format --write"]
  }
}
